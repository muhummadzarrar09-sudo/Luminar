<?xml version="1.0" encoding="utf-8"?>
<!--
    The Recto mark: an open book reduced to two leaves, with the right-hand
    page - the recto - picked out in the accent colour.

    Adaptive icon foregrounds are 108x108dp with the outer 18dp on each side
    reserved for masking, so all artwork stays inside the central 72x72dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- verso: the left-hand leaf -->
    <path
        android:fillColor="#6B615A"
        android:pathData="M25,32 L52,36 L52,78 L25,74 Z" />

    <!-- recto: the right-hand leaf, the one we are named for -->
    <path
        android:fillColor="#8C5A3C"
        android:pathData="M56,36 L83,32 L83,74 L56,78 Z" />

    <!-- the spine -->
    <path
        android:fillColor="#3A2F24"
        android:pathData="M52.5,35 L55.5,35 L55.5,79 L52.5,79 Z" />

</vector>
