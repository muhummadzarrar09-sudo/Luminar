<?xml version="1.0" encoding="utf-8"?>
<!--
    Monochrome variant for Android 13+ themed icons. The system tints this
    with the user's wallpaper colours, so it must be a single flat shape -
    the three-tone version would come out as an unreadable silhouette.

    Here the two leaves are drawn as outlines with a solid spine, so the book
    still reads as a book when everything is one colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- verso outline -->
    <path
        android:fillColor="#000000"
        android:pathData="M26,32.5 L52.4,39.2 L52.4,77.5 L26,77.5 Z
                          M29.5,36.9 L29.5,74 L48.9,74 L48.9,41.8 Z" />

    <!-- recto outline -->
    <path
        android:fillColor="#000000"
        android:pathData="M82,32.5 L55.6,39.2 L55.6,77.5 L82,77.5 Z
                          M78.5,36.9 L59.1,41.8 L59.1,74 L78.5,74 Z" />

    <!-- spine, solid -->
    <path
        android:fillColor="#000000"
        android:pathData="M52.4,38.6 L55.6,38.6 L55.6,77.5 L52.4,77.5 Z" />

</vector>
